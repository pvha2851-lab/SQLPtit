SELECT name
FROM Employee
WHERE id IN(
    SELECT managerId
    FROM Employee
    GROUP BY managerId
    /*GROUP BY managerId:
    Gom nhân viên thành từng 
    nhóm dựa trên người sếp quản lý họ
    (Ví dụ: Nhóm lính của sếp 101
    nhóm lính của sếp 102...)*/
    HAVING COUNT(id)>=5
    /*Bạn đếm số lượng nhân viên trong từng nhóm
    Nhóm nào có từ 5 người trở lên 
    thì bạn giữ lại mã ID của vị sếp đó*/
);
/*Tìm tên thỏa mãn bằng WHERE*/
